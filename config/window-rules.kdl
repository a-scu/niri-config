layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Nautilus"
    default-column-width { proportion 0.3; }
    // default-window-height { proportion 0.5; }
    // opacity 0.95
    // background-effect {
    //     xray true
    //     blur true
    //     noise 0.05
    //     saturation 3
    // }
}

window-rule {
    match title="^Rename.*"
    match title="^All Files$"
    match title="^Save File$"
    match title="^Open File$"
    match title="^Select a File$"
    match title="^Choose Wallpaper$"

    open-floating true
    draw-border-with-background false
    geometry-corner-radius 0

    border {
        on
        width 3
    }
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.33333; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}

window-rule {
    match app-id="kitty-fitlog"
    open-on-output "DP-2"
    default-column-width { proportion 0.33333; }
}

window-rule {
    match app-id="^chrome-fitlog$"
    open-on-output "DP-2"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="^chrome-startup$"
    open-on-output "DP-1"
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id="^brave-fitlog$"
    open-on-output "DP-2"
    default-column-width { proportion 0.7; }
}

window-rule {
    match app-id="^brave-startup$"
    open-on-output "DP-1"
    default-column-width { proportion 0.66667; }
}

window-rule {
    match app-id="scrcpy"
    open-on-output "DP-1"
    default-column-width { proportion 0.194565; }
}

window-rule {
    match app-id="dev.zed.Zed"
}

window-rule {
    match app-id="dotnet" title="^Terraria.*"
    open-on-output "DP-1"
    open-maximized true
    open-focused false
}

window-rule {
    match app-id="steam_app_731490"
    open-on-output "DP-1"
    open-maximized true
    open-focused false
    open-floating false
}

window-rule {
    match app-id="steam_app_2424420"
    open-on-output "DP-1"
    open-fullscreen true
    open-focused false
    open-floating false
}
