layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
    draw-border-with-background false
}

window-rule {
    match app-id="org.gnome.Nautilus"
    match app-id="org.gnome.Nautilus"
    default-column-width { proportion 0.25; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}

window-rule {
    match title="^Rename.*"
    match title="^All Files$"
    match title="^Save File$"
    match title="^Open File$"
    match title="^Select a File$"
    match title="^Choose Wallpaper$"
    open-floating true
}

window-rule {
    match app-id="kitty"
    default-column-width { proportion 0.2; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}

window-rule {
    match app-id="scrcpy"
    open-on-output "DP-1"
    default-column-width { proportion 0.194565; }
}

window-rule {
    match app-id="transmission-qt"
    default-column-width { proportion 0.20; }
    default-window-height { proportion 0.33333; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}

window-rule {
    match app-id="dev.zed.Zed"
    default-column-width { proportion 0.4; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}

window-rule {
    match app-id="brave-origin-nightly"
    // opacity 0.95
    // background-effect {
    //     xray true
    //     blur true
    //     noise 0.05
    //     saturation 3
    // }
}

window-rule {
    match app-id="dev.noctalia.Noctalia" title="Noctalia Settings"
    default-column-width { proportion 0.33333; }
    opacity 0.95
    background-effect {
        xray true
        blur true
        noise 0.05
        saturation 3
    }
}


// Steam

window-rule {
    match app-id="steam"
    exclude title=r#"^[Ss]team$"#
    open-floating true
}

window-rule {
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}

window-rule {
    match app-id=r"^steam_app_\d+$"
    open-on-output "DP-1"
    open-fullscreen true
    open-focused false
    open-floating false
}

window-rule {
    match app-id="dotnet" title="^Terraria.*"
    open-on-output "DP-1"
    open-maximized true
    open-focused false
}
